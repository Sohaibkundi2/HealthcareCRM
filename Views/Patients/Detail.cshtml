@model int

@{
    ViewData["Title"] = "Patient Detail";
}

<style>
    .patient-detail-page {
        --d-bg: #0a0a0a;
        --d-panel: #111;
        --d-border: #222;
        --d-accent: #00ff88;
        --d-text: #f2f2f2;
        --d-muted: #666;

        background: var(--d-bg);
        color: var(--d-text);
        font-family: 'Segoe UI', sans-serif;
        padding: 2.5rem 3rem;
        min-height: 100vh;
        border-radius: 12px;
    }

    .patient-detail-page .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.75rem;
    }

    .patient-detail-page .page-header h2 {
        font-weight: 800;
        letter-spacing: -0.5px;
        margin: 0;
    }

    .patient-detail-page .btn-back {
        background: transparent;
        border: 1px solid var(--d-border);
        color: var(--d-text);
        padding: 0.5rem 1.1rem;
        border-radius: 8px;
        font-size: 0.85rem;
        text-decoration: none;
        transition: border-color 0.15s, color 0.15s;
    }

    .patient-detail-page .btn-back:hover { border-color: var(--d-accent); color: var(--d-accent); }

    .patient-detail-page .loading {
        text-align: center;
        padding: 4rem 0;
        color: var(--d-muted);
    }

    .patient-detail-page .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid var(--d-border);
        border-top-color: var(--d-accent);
        border-radius: 50%;
        margin: 0 auto 1rem;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    .patient-detail-page .panel {
        background: var(--d-panel);
        border: 1px solid var(--d-border);
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    .patient-detail-page .profile-header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 2rem;
    }

    .patient-detail-page .avatar {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: rgba(0,255,136,0.12);
        color: var(--d-accent);
        border: 1px solid rgba(0,255,136,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        font-weight: 800;
        flex-shrink: 0;
    }

    .patient-detail-page .profile-name {
        font-size: 1.5rem;
        font-weight: 800;
        margin: 0 0 0.4rem;
    }

    .patient-detail-page .pill {
        display: inline-block;
        background: rgba(0,255,136,0.12);
        color: var(--d-accent);
        border: 1px solid rgba(0,255,136,0.3);
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.25rem 0.7rem;
        border-radius: 100px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .patient-detail-page .profile-email {
        color: var(--d-muted);
        font-size: 0.9rem;
        margin: 0.5rem 0 0;
    }

    .patient-detail-page .btn-edit {
        margin-left: auto;
        background: var(--d-accent);
        color: #0a0a0a;
        border: none;
        padding: 0.6rem 1.3rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .patient-detail-page .btn-edit:hover { opacity: 0.9; }

    .patient-detail-page .panel-title {
        padding: 1rem 2rem;
        border-bottom: 1px solid var(--d-border);
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--d-text);
    }

    .patient-detail-page .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        padding: 1.5rem 2rem;
    }

    .patient-detail-page .info-cell {
        background: var(--d-bg);
        border: 1px solid var(--d-border);
        border-radius: 10px;
        padding: 1rem 1.1rem;
    }

    .patient-detail-page .info-label {
        color: var(--d-muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: block;
        margin-bottom: 0.35rem;
    }

    .patient-detail-page .info-value {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--d-text);
    }

    @@media (max-width: 700px) {
        .patient-detail-page .info-grid { grid-template-columns: 1fr; }
        .patient-detail-page .profile-header { flex-wrap: wrap; }
        .patient-detail-page .btn-edit { margin-left: 0; }
    }
</style>

<div class="patient-detail-page">
    <div class="page-header">
        <h2>Patient Detail</h2>
        <a href="/Patients" class="btn-back">← Back to Patients</a>
    </div>

    <div id="loading" class="loading">
        <div class="spinner"></div>
        <p>Loading patient...</p>
    </div>

    <div id="patient-detail" class="d-none">
        <div class="panel">
            <div class="profile-header">
                <div class="avatar" id="avatar-initials"></div>
                <div>
                    <h3 class="profile-name" id="detail-fullName"></h3>
                    <span class="pill" id="detail-gender"></span>
                    <p class="profile-email" id="detail-email"></p>
                </div>
                <button class="btn-edit" onclick="goToEdit()">Edit Patient</button>
            </div>
        </div>

        <div class="panel">
            <div class="panel-title">Patient Information</div>
            <div class="info-grid">
                <div class="info-cell">
                    <span class="info-label">Phone</span>
                    <span class="info-value" id="detail-phone"></span>
                </div>
                <div class="info-cell">
                    <span class="info-label">Date of Birth</span>
                    <span class="info-value" id="detail-dob"></span>
                </div>
                <div class="info-cell">
                    <span class="info-label">Address</span>
                    <span class="info-value" id="detail-address"></span>
                </div>
                <div class="info-cell">
                    <span class="info-label">Registered On</span>
                    <span class="info-value" id="detail-createdAt"></span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const token = localStorage.getItem('jwt');

    if (!token) {
        window.location.href = '/Account/Login';
    }

    const patientId = @Model;
    let patientData = null;

    async function loadPatient() {
        try {
            const response = await fetch(`/api/patients/${patientId}`, {
                headers: {
                    Authorization: `Bearer ${token}`
                }
            });

            // Handle expired/invalid token
            if (response.status === 401) {
                localStorage.removeItem('jwt');
                window.location.href = '/Account/Login';
                return;
            }

            const result = await response.json();

            if (!response.ok) {
                document.getElementById('loading').innerHTML =
                    '<p style="color:#ff6b6b;">Patient not found.</p>';
                return;
            }

            const p = result.data;
            patientData = p;

            // Avatar initials (safe)
            const initials = (p.fullName || '')
                .trim()
                .split(/\s+/)
                .map(name => name[0])
                .join('')
                .toUpperCase();

            document.getElementById('avatar-initials').textContent = initials || '?';

            document.getElementById('detail-fullName').textContent = p.fullName;
            document.getElementById('detail-gender').textContent = p.gender;
            document.getElementById('detail-email').textContent = p.email || 'No email provided';
            document.getElementById('detail-phone').textContent = p.phone;

            document.getElementById('detail-dob').textContent =
                new Date(p.dateOfBirth).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });

                const dob = new Date(p.dateOfBirth);
                const age = Math.floor((new Date() - dob) / (365.25 * 24 * 60 * 60 * 1000));
                document.getElementById('detail-dob').textContent =
                    new Date(p.dateOfBirth).toLocaleDateString('en-US', {
                        year: 'numeric', month: 'long', day: 'numeric'
                    }) + ` (Age: ${age})`;

            document.getElementById('detail-address').textContent =
                p.address || '—';

            document.getElementById('detail-createdAt').textContent =
                new Date(p.createdAt).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });

            document.getElementById('loading').classList.add('d-none');
            document.getElementById('patient-detail').classList.remove('d-none');
        }
        catch (error) {
            console.error('Failed to load patient:', error);

            document.getElementById('loading').innerHTML = `
                <div>
                    <p style="color:#ff6b6b; margin-bottom: 0.75rem;">Unable to load patient.</p>
                    <button class="btn-back" style="cursor:pointer;" onclick="loadPatient()">
                        Try Again
                    </button>
                </div>
            `;
        }
    }

    function goToEdit() {
        if (!patientData) return;

        sessionStorage.setItem('editPatient', JSON.stringify(patientData));
        window.location.href = '/Patients';
    }

    loadPatient();
</script>

@{
    ViewData["Title"] = "Patients";
}

<div class="patients-page">
    <div class="page-header">
        <h2>
            <svg viewBox="0 0 48 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M0,12 L10,12 L14,3 L18,21 L22,12 L26,12 L30,18 L34,6 L38,12 L48,12"
                      fill="none" stroke="#00ff88" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Patients
        </h2>
        <div class="d-flex gap-2 align-items-center">
            <button id="export-btn" class="btn-export d-none" onclick="exportCSV()">
                ⬇ Export CSV
            </button>
            <button class="btn-accent" onclick="showAddForm()">+ Add Patient</button>
        </div>
    </div>

    <div class="search-wrap">
        <input type="text" id="search-input" class="search-input"
               placeholder="Search patients by name..."
               oninput="onSearchInput(this.value)" />
    </div>

    <div class="panel">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Phone</th>
                    <th>Gender</th>
                    <th>Date of Birth</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="patients-table">
                <tr>
                    <td colspan="6" class="empty-row">
                        <div style="display:flex;justify-content:center;padding:2rem;">
                            <div class="spinner-border" style="color:#00ff88;" role="status"></div>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

        <div class="pagination-row" id="pagination-controls"></div>
    </div>

    <!-- Add/Edit Modal -->
    <div class="modal fade" id="patientModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-title">Add Patient</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="form-error" class="alert-crm alert-crm-error d-none"></div>
                    <input type="hidden" id="patient-id" />
                    <div class="mb-3">
                        <label class="dark-label">Full Name</label>
                        <input type="text" id="fullName" class="dark-input" placeholder="Enter full name" />
                    </div>
                    <div class="mb-3">
                        <label class="dark-label">Email</label>
                        <input type="email" id="email" class="dark-input" placeholder="Enter email" />
                    </div>
                    <div class="mb-3">
                        <label class="dark-label">Phone</label>
                        <input type="text" id="phone" class="dark-input" placeholder="Enter phone number" />
                    </div>
                    <div class="mb-3">
                        <label class="dark-label">Date of Birth</label>
                        <input type="date" id="dateOfBirth" class="dark-input" />
                    </div>
                    <div class="mb-3">
                        <label class="dark-label">Gender</label>
                        <select id="gender" class="dark-select">
                            <option value="">Select gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="dark-label">Address</label>
                        <textarea id="address" class="dark-textarea" placeholder="Enter address"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-cancel-modal" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn-accent" onclick="savePatient()">Save</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirm Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete <strong id="delete-patient-name"></strong>? This action cannot be undone.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    if (!token) window.location.href = '/Account/Login';


        // Show export button only for Admin
    try {
        const payload = JSON.parse(atob(token.split('.')[1]));
        const role = payload['http://schemas.microsoft.com/ws/2008/06/identity/claims/role'];
        if (role === 'Admin') {
            document.getElementById('export-btn').classList.remove('d-none');
        }
    } catch (e) {}

    async function exportCSV() {
        const response = await fetch('/api/patients/export?format=csv', {
            headers: { 'Authorization': `Bearer ${token}` }
        });

        if (response.ok) {
            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `patients_${new Date().toISOString().split('T')[0]}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
        }
    }
    const PAGE_SIZE = 20;

    let currentSearch = '';
    let currentPage = 1;
    let deleteTargetId = null;
    let searchDebounceTimer = null;

    loadPatients();

    async function loadPatients() {
        const params = new URLSearchParams({ pageNumber: currentPage, pageSize: PAGE_SIZE });
        if (currentSearch) params.set('search', currentSearch);

        const response = await fetch(`/api/patients?${params.toString()}`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        const result = await response.json();
        renderPatients(result.data);
        renderPagination(result.pageNumber, result.totalPages);
    }

    function renderPatients(patients) {
        const tbody = document.getElementById('patients-table');
        if (!patients || patients.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="empty-row">No patients found</td></tr>';
            return;
        }
        tbody.innerHTML = patients.map((p, i) => `
            <tr>
                <td>${(currentPage - 1) * PAGE_SIZE + i + 1}</td>
                <td>${escapeHtml(p.fullName)}</td>
                <td>${escapeHtml(p.phone)}</td>
                <td>${escapeHtml(p.gender)}</td>
                <td>${new Date(p.dateOfBirth).toLocaleDateString()}</td>
                <td>
                    <a href="/Patients/Detail/${p.id}" class="btn-ghost view">View</a>
                    <button class="btn-ghost edit" onclick="showEditForm(${JSON.stringify(p).replace(/"/g, '&quot;')})">Edit</button>
                    <button class="btn-ghost delete" onclick="showDeleteConfirm(${p.id}, '${p.fullName.replace(/'/g, "\\'")}')">Delete</button>
                </td>
            </tr>
        `).join('');
    }

        function escapeHtml(text) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(text || ''));
        return div.innerHTML;
    }

    function renderPagination(pageNumber, totalPages) {
        const el = document.getElementById('pagination-controls');
        if (totalPages <= 1) {
            el.innerHTML = '';
            return;
        }

        let html = `<button class="page-btn text-btn" ${pageNumber === 1 ? 'disabled' : ''} onclick="goToPage(${pageNumber - 1})">Previous</button>`;

        for (let i = 1; i <= totalPages; i++) {
            html += `<button class="page-btn ${i === pageNumber ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
        }

        html += `<button class="page-btn text-btn" ${pageNumber === totalPages ? 'disabled' : ''} onclick="goToPage(${pageNumber + 1})">Next</button>`;

        el.innerHTML = html;
    }

    function goToPage(page) {
        currentPage = page;
        loadPatients();
    }

    function onSearchInput(value) {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => {
            currentSearch = value;
            currentPage = 1;
            loadPatients();
        }, 300);
    }

    function showAddForm() {
        document.getElementById('modal-title').textContent = 'Add Patient';
        document.getElementById('patient-id').value = '';
        document.getElementById('fullName').value = '';
        document.getElementById('email').value = '';
        document.getElementById('phone').value = '';
        document.getElementById('dateOfBirth').value = '';
        document.getElementById('gender').value = '';
        document.getElementById('address').value = '';
        document.getElementById('form-error').classList.add('d-none');
        new bootstrap.Modal(document.getElementById('patientModal')).show();
    }

    function showEditForm(patient) {
        document.getElementById('modal-title').textContent = 'Edit Patient';
        document.getElementById('patient-id').value = patient.id;
        document.getElementById('fullName').value = patient.fullName;
        document.getElementById('email').value = patient.email;
        document.getElementById('phone').value = patient.phone;
        document.getElementById('dateOfBirth').value = patient.dateOfBirth.split('T')[0];
        document.getElementById('gender').value = patient.gender;
        document.getElementById('address').value = patient.address;
        document.getElementById('form-error').classList.add('d-none');
        new bootstrap.Modal(document.getElementById('patientModal')).show();
    }

    async function savePatient() {
        const id = document.getElementById('patient-id').value;
        const fullName = document.getElementById('fullName').value.trim();
        const phone = document.getElementById('phone').value.trim();
        const dateOfBirth = document.getElementById('dateOfBirth').value;
        const gender = document.getElementById('gender').value;
        const errorDiv = document.getElementById('form-error');

        if (!fullName) {
            errorDiv.classList.remove('d-none');
            errorDiv.textContent = 'Full name is required';
            return;
        }
        if (!phone) {
            errorDiv.classList.remove('d-none');
            errorDiv.textContent = 'Phone is required';
            return;
        }
        if (!dateOfBirth) {
            errorDiv.classList.remove('d-none');
            errorDiv.textContent = 'Date of birth is required';
            return;
        }
        if (!gender) {
            errorDiv.classList.remove('d-none');
            errorDiv.textContent = 'Gender is required';
            return;
        }

        errorDiv.classList.add('d-none');

        const patient = {
            fullName,
            email: document.getElementById('email').value,
            phone,
            dateOfBirth,
            gender,
            address: document.getElementById('address').value,
            createdBy: 1
        };

        const url = id ? `/api/patients/${id}` : '/api/patients';
        const method = id ? 'PUT' : 'POST';

        const response = await fetch(url, {
            method,
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(patient)
        });

        const result = await response.json();

        if (response.ok) {
            bootstrap.Modal.getInstance(document.getElementById('patientModal')).hide();
            loadPatients();
        } else {
            errorDiv.classList.remove('d-none');
            errorDiv.textContent = result.message;
        }
    }

    function showDeleteConfirm(id, fullName) {
        deleteTargetId = id;
        document.getElementById('delete-patient-name').textContent = fullName;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    async function confirmDelete() {
        if (!deleteTargetId) return;

        const response = await fetch(`/api/patients/${deleteTargetId}`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
        });

        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();

        if (response.ok) {
            deleteTargetId = null;
            const tbody = document.getElementById('patients-table');
            if (tbody.children.length === 1 && currentPage > 1) {
                currentPage--;
            }
            loadPatients();
        } else if (response.status !== 403) {
            // 403 handled by global fetch interceptor in _Layout
            const result = await response.json();
            document.getElementById('patients-table').innerHTML = `
                <tr>
                    <td colspan="6" style="text-align:center; color:#ff6b6b; padding:2rem;">
                        ${result.message || 'Failed to delete patient'}
                    </td>
                </tr>`;
        }
    }
</script>

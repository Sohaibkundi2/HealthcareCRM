@{
    ViewData["Title"] = "Patients";
}

<style>
    .patients-page {
        --p-bg: #0a0a0a;
        --p-panel: #111;
        --p-border: #222;
        --p-border-soft: #1a1a1a;
        --p-accent: #00ff88;
        --p-text: #f2f2f2;
        --p-muted: #666;
        --p-danger: #ff6b6b;
        --p-warning: #ffcc66;
        --p-info: #6ec8ff;

        background: var(--p-bg);
        color: var(--p-text);
        font-family: 'Segoe UI', sans-serif;
        padding: 2.5rem 3rem;
        min-height: 100vh;
        border-radius: 12px;
    }

    .patients-page .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.75rem;
    }

    .patients-page .page-header h2 {
        font-weight: 800;
        letter-spacing: -0.5px;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .patients-page .page-header svg {
        width: 22px;
        height: 22px;
        filter: drop-shadow(0 0 4px rgba(0,255,136,0.6));
    }

    .patients-page .btn-accent {
        background: var(--p-accent);
        color: #0a0a0a;
        border: none;
        padding: 0.6rem 1.3rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
    }

    .patients-page .btn-accent:hover { opacity: 0.9; transform: translateY(-1px); }

    .patients-page .search-wrap { margin-bottom: 1.25rem; }

    .patients-page .search-input {
        width: 100%;
        background: var(--p-panel);
        border: 1px solid var(--p-border);
        color: var(--p-text);
        padding: 0.7rem 1rem;
        border-radius: 8px;
        font-size: 0.9rem;
    }

    .patients-page .search-input::placeholder { color: #444; }

    .patients-page .search-input:focus {
        outline: none;
        border-color: var(--p-accent);
        box-shadow: 0 0 0 3px rgba(0,255,136,0.12);
    }

    .patients-page .panel {
        background: var(--p-panel);
        border: 1px solid var(--p-border);
        border-radius: 14px;
        overflow: hidden;
    }

    .patients-page table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

    .patients-page thead th {
        text-align: left;
        padding: 0.9rem 1.25rem;
        color: var(--p-muted);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        font-weight: 700;
        border-bottom: 1px solid var(--p-border);
    }

    .patients-page tbody td {
        padding: 0.9rem 1.25rem;
        border-bottom: 1px solid var(--p-border-soft);
        color: var(--p-text);
    }

    .patients-page tbody tr:last-child td { border-bottom: none; }
    .patients-page tbody tr:hover { background: rgba(0,255,136,0.03); }

    .patients-page .empty-row {
        text-align: center;
        color: var(--p-muted);
        padding: 2.5rem 0;
    }

    .patients-page .btn-ghost {
        background: transparent;
        border: 1px solid var(--p-border);
        color: var(--p-text);
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        font-size: 0.8rem;
        text-decoration: none;
        display: inline-block;
        margin-right: 0.35rem;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
    }

    .patients-page .btn-ghost.view:hover { border-color: var(--p-info); color: var(--p-info); }
    .patients-page .btn-ghost.edit:hover { border-color: var(--p-warning); color: var(--p-warning); }
    .patients-page .btn-ghost.delete:hover { border-color: var(--p-danger); color: var(--p-danger); }

    .patients-page .pagination-row {
        display: flex;
        justify-content: center;
        gap: 0.4rem;
        padding: 1.25rem;
    }

    .patients-page .page-btn {
        background: transparent;
        border: 1px solid var(--p-border);
        color: var(--p-text);
        width: 34px;
        height: 34px;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
    }

    .patients-page .page-btn:hover { border-color: var(--p-accent); color: var(--p-accent); }
    .patients-page .page-btn.active { background: var(--p-accent); color: #0a0a0a; border-color: var(--p-accent); font-weight: 700; }
    .patients-page .page-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .patients-page .page-btn.text-btn { width: auto; padding: 0 0.9rem; }

    /* Modal overrides */
    .patients-page .modal-content {
        background: var(--p-panel);
        border: 1px solid var(--p-border);
        border-radius: 14px;
        color: var(--p-text);
    }

    .patients-page .modal-header,
    .patients-page .modal-footer {
        border-color: var(--p-border);
    }

    .patients-page .modal-title { font-weight: 700; }

    .patients-page .btn-close {
        filter: invert(1) grayscale(1) brightness(1.6);
    }

    .patients-page .form-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #aaa;
    }

    .patients-page .form-control,
    .patients-page .form-select {
        background: var(--p-bg);
        border: 1px solid var(--p-border);
        color: var(--p-text);
    }

    .patients-page .form-control::placeholder { color: #444; }

    .patients-page .form-control:focus,
    .patients-page .form-select:focus {
        background: var(--p-bg);
        border-color: var(--p-accent);
        color: var(--p-text);
        box-shadow: 0 0 0 3px rgba(0,255,136,0.12);
    }

    .patients-page .alert-danger {
        background: #2a1212;
        border: 1px solid #4a1f1f;
        color: #ff8f8f;
    }

    .patients-page .btn-secondary {
        background: transparent;
        border: 1px solid var(--p-border);
        color: var(--p-text);
    }

    .patients-page .btn-danger {
        background: var(--p-danger);
        border: none;
        color: #1a0000;
        font-weight: 700;
    }

    .patients-page .btn-primary {
        background: var(--p-accent);
        border: none;
        color: #0a0a0a;
        font-weight: 700;
    }
</style>

<div class="patients-page">
    <div class="page-header">
        <h2>
            <svg viewBox="0 0 48 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M0,12 L10,12 L14,3 L18,21 L22,12 L26,12 L30,18 L34,6 L38,12 L48,12"
                      fill="none" stroke="#00ff88" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Patients
        </h2>
        <button class="btn-accent" onclick="showAddForm()">+ Add Patient</button>
    </div>

    <div class="search-wrap">
        <input type="text" id="search-input" class="search-input"
               placeholder="Search patients by name..."
               oninput="onSearchInput(this.value)" />
    </div>

    <div class="panel">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Phone</th>
                    <th>Gender</th>
                    <th>Date of Birth</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="patients-table">
                <tr>
                    <td colspan="6" class="empty-row">
                        <div style="display:flex;justify-content:center;padding:2rem;">
                            <div class="spinner-border" style="color:#00ff88;" role="status"></div>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

        <div class="pagination-row" id="pagination-controls"></div>
    </div>

    <!-- Add/Edit Modal -->
    <div class="modal fade" id="patientModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-title">Add Patient</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="form-error" class="alert alert-danger d-none"></div>
                    <input type="hidden" id="patient-id" />
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" id="fullName" class="form-control" placeholder="Enter full name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" id="email" class="form-control" placeholder="Enter email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" id="phone" class="form-control" placeholder="Enter phone number" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date of Birth</label>
                        <input type="date" id="dateOfBirth" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Gender</label>
                        <select id="gender" class="form-select">
                            <option value="">Select gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <textarea id="address" class="form-control" placeholder="Enter address"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="savePatient()">Save</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirm Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete <strong id="delete-patient-name"></strong>? This action cannot be undone.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const token = localStorage.getItem('jwt');
    if (!token) window.location.href = '/Account/Login';

    const PAGE_SIZE = 20;

    let currentSearch = '';
    let currentPage = 1;
    let deleteTargetId = null;
    let searchDebounceTimer = null;

    loadPatients();

    async function loadPatients() {
        const params = new URLSearchParams({ pageNumber: currentPage, pageSize: PAGE_SIZE });
        if (currentSearch) params.set('search', currentSearch);

        const response = await fetch(`/api/patients?${params.toString()}`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        const result = await response.json();
        renderPatients(result.data);
        renderPagination(result.pageNumber, result.totalPages);
    }

    function renderPatients(patients) {
        const tbody = document.getElementById('patients-table');
        if (!patients || patients.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="empty-row">No patients found</td></tr>';
            return;
        }
        tbody.innerHTML = patients.map((p, i) => `
            <tr>
                <td>${(currentPage - 1) * PAGE_SIZE + i + 1}</td>
                <td>${escapeHtml(p.fullName)}</td>
                <td>${escapeHtml(p.phone)}</td>
                <td>${escapeHtml(p.gender)}</td>
                <td>${new Date(p.dateOfBirth).toLocaleDateString()}</td>
                <td>
                    <a href="/Patients/Detail/${p.id}" class="btn-ghost view">View</a>
                    <button class="btn-ghost edit" onclick="showEditForm(${JSON.stringify(p).replace(/"/g, '&quot;')})">Edit</button>
                    <button class="btn-ghost delete" onclick="showDeleteConfirm(${p.id}, '${p.fullName.replace(/'/g, "\\'")}')">Delete</button>
                </td>
            </tr>
        `).join('');
    }

        function escapeHtml(text) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(text || ''));
        return div.innerHTML;
    }

    function renderPagination(pageNumber, totalPages) {
        const el = document.getElementById('pagination-controls');
        if (totalPages <= 1) {
            el.innerHTML = '';
            return;
        }

        let html = `<button class="page-btn text-btn" ${pageNumber === 1 ? 'disabled' : ''} onclick="goToPage(${pageNumber - 1})">Previous</button>`;

        for (let i = 1; i <= totalPages; i++) {
            html += `<button class="page-btn ${i === pageNumber ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
        }

        html += `<button class="page-btn text-btn" ${pageNumber === totalPages ? 'disabled' : ''} onclick="goToPage(${pageNumber + 1})">Next</button>`;

        el.innerHTML = html;
    }

    function goToPage(page) {
        currentPage = page;
        loadPatients();
    }

    function onSearchInput(value) {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => {
            currentSearch = value;
            currentPage = 1;
            loadPatients();
        }, 300);
    }

    function showAddForm() {
        document.getElementById('modal-title').textContent = 'Add Patient';
        document.getElementById('patient-id').value = '';
        document.getElementById('fullName').value = '';
        document.getElementById('email').value = '';
        document.getElementById('phone').value = '';
        document.getElementById('dateOfBirth').value = '';
        document.getElementById('gender').value = '';
        document.getElementById('address').value = '';
        document.getElementById('form-error').classList.add('d-none');
        new bootstrap.Modal(document.getElementById('patientModal')).show();
    }

    function showEditForm(patient) {
        document.getElementById('modal-title').textContent = 'Edit Patient';
        document.getElementById('patient-id').value = patient.id;
        document.getElementById('fullName').value = patient.fullName;
        document.getElementById('email').value = patient.email;
        document.getElementById('phone').value = patient.phone;
        document.getElementById('dateOfBirth').value = patient.dateOfBirth.split('T')[0];
        document.getElementById('gender').value = patient.gender;
        document.getElementById('address').value = patient.address;
        document.getElementById('form-error').classList.add('d-none');
        new bootstrap.Modal(document.getElementById('patientModal')).show();
    }

    async function savePatient() {
        const id = document.getElementById('patient-id').value;
        const fullName = document.getElementById('fullName').value.trim();
        const phone = document.getElementById('phone').value.trim();
        const dateOfBirth = document.getElementById('dateOfBirth').value;
        const gender = document.getElementById('gender').value;
        const errorDiv = document.getElementById('form-error');

        if (!fullName) {
            errorDiv.classList.remove('d-none');
            errorDiv.textContent = 'Full name is required';
            return;
        }
        if (!phone) {
            errorDiv.classList.remove('d-none');
            errorDiv.textContent = 'Phone is required';
            return;
        }
        if (!dateOfBirth) {
            errorDiv.classList.remove('d-none');
            errorDiv.textContent = 'Date of birth is required';
            return;
        }
        if (!gender) {
            errorDiv.classList.remove('d-none');
            errorDiv.textContent = 'Gender is required';
            return;
        }

        errorDiv.classList.add('d-none');

        const patient = {
            fullName,
            email: document.getElementById('email').value,
            phone,
            dateOfBirth,
            gender,
            address: document.getElementById('address').value,
            createdBy: 1
        };

        const url = id ? `/api/patients/${id}` : '/api/patients';
        const method = id ? 'PUT' : 'POST';

        const response = await fetch(url, {
            method,
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(patient)
        });

        const result = await response.json();

        if (response.ok) {
            bootstrap.Modal.getInstance(document.getElementById('patientModal')).hide();
            loadPatients();
        } else {
            errorDiv.classList.remove('d-none');
            errorDiv.textContent = result.message;
        }
    }

    function showDeleteConfirm(id, fullName) {
        deleteTargetId = id;
        document.getElementById('delete-patient-name').textContent = fullName;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    async function confirmDelete() {
        if (!deleteTargetId) return;

        const response = await fetch(`/api/patients/${deleteTargetId}`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
        });

        bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();

        if (response.ok) {
            deleteTargetId = null;
            const tbody = document.getElementById('patients-table');
            if (tbody.children.length === 1 && currentPage > 1) {
                currentPage--;
            }
            loadPatients();
        } else {
            const result = await response.json();
            alert(result.message || 'Failed to delete patient');
        }
    }
</script>

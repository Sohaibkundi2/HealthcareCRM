@{
    ViewData["Title"] = "Doctors";
}



<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title mb-0">Doctors</h2>
        <div class="d-flex align-items-center gap-3">
            <label class="toggle-label">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="show-inactive" onchange="toggleInactive(this.checked)">
                </div>
                Show Inactive
            </label>
            <button class="btn-add" onclick="showAddForm()">+ Add Doctor</button>
        </div>
    </div>

    <!-- Loading -->
    <div id="loading" class="text-center py-5">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2" style="color:#555;">Loading doctors...</p>
    </div>

    <!-- Table -->
    <div class="dark-card d-none" id="doctors-card">
        <table class="dark-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Specialization</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="doctors-table"></tbody>
        </table>
        <div id="empty-state" class="empty-state d-none">
            No doctors found.
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="doctorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-title">Add Doctor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="form-error" class="alert-dark-error d-none"></div>
                <input type="hidden" id="doctor-id" />
                <div class="mb-3">
                    <label class="dark-label">Full Name</label>
                    <input type="text" id="name" class="dark-input" placeholder="Enter doctor name" />
                </div>
                <div class="mb-3">
                    <label class="dark-label">Specialization</label>
                    <input type="text" id="specialization" class="dark-input" placeholder="e.g. Cardiologist" />
                </div>
                <div class="mb-3">
                    <label class="dark-label">Phone</label>
                    <input type="text" id="phone" class="dark-input" placeholder="Enter phone number" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel-modal" data-bs-dismiss="modal">Cancel</button>
                <button id="save-btn" class="btn-save" onclick="saveDoctor()">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Deactivate Confirm Modal -->
<div class="modal fade" id="deactivateModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deactivate-title">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="deactivate-body" style="color: #aaa;">
                Are you sure?
            </div>
            <div class="modal-footer">
                <button class="btn-cancel-modal" data-bs-dismiss="modal">Cancel</button>
                <button id="deactivate-btn" class="btn-save" onclick="confirmToggle()">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
    if (!token) window.location.href = '/Account/Login';

    let toggleTargetId = null;
    let toggleIsActive = false;
    let showInactive = false;

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(text || ''));
        return div.innerHTML;
    }

    async function loadDoctors() {
        try {
            const url = showInactive ? '/api/doctors?includeInactive=true' : '/api/doctors';
            const response = await fetch(url, {
                headers: { 'Authorization': `Bearer ${token}` }
            });

            if (!response.ok) throw new Error('Failed to load');

            const result = await response.json();

            document.getElementById('loading').classList.add('d-none');
            document.getElementById('doctors-card').classList.remove('d-none');

            if (!result.data || result.data.length === 0) {
                document.getElementById('empty-state').classList.remove('d-none');
                document.getElementById('doctors-table').innerHTML = '';
                return;
            }

            document.getElementById('empty-state').classList.add('d-none');
            document.getElementById('doctors-table').innerHTML = result.data.map((d, i) => `
                <tr>
                    <td style="color:#555;">${i + 1}</td>
                    <td style="font-weight:600;">${escapeHtml(d.name)}</td>
                    <td style="color:#888;">${escapeHtml(d.specialization)}</td>
                    <td style="color:#888;">${escapeHtml(d.phone)}</td>
                    <td>
                        <span class="${d.isActive ? 'badge-active' : 'badge-inactive'}">
                            ${d.isActive ? 'Active' : 'Inactive'}
                        </span>
                    </td>
                    <td>
                        <button class="btn-ghost-crm edit me-1" onclick="showEditForm(${JSON.stringify(d).replace(/"/g, '&quot;')})">Edit</button>
                        <button class="btn-ghost-crm delete ${!d.isActive ? 'btn-reactivate' : ''}"
                            onclick="showToggleConfirm(${d.id}, ${d.isActive}, '${d.name.replace(/'/g, "\\'")}')">
                            ${d.isActive ? 'Deactivate' : 'Reactivate'}
                        </button>
                    </td>
                </tr>
            `).join('');

        } catch (err) {
            document.getElementById('loading').innerHTML =
                '<p style="color:#ff6b6b; text-align:center;">Failed to load doctors. Please try again.</p>';
        }
    }

    function toggleInactive(checked) {
        showInactive = checked;
        document.getElementById('loading').classList.remove('d-none');
        document.getElementById('doctors-card').classList.add('d-none');
        loadDoctors();
    }

    function showAddForm() {
        document.getElementById('modal-title').textContent = 'Add Doctor';
        document.getElementById('doctor-id').value = '';
        document.getElementById('name').value = '';
        document.getElementById('specialization').value = '';
        document.getElementById('phone').value = '';
        document.getElementById('form-error').classList.add('d-none');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('doctorModal')).show();
    }

    function showEditForm(doctor) {
        document.getElementById('modal-title').textContent = 'Edit Doctor';
        document.getElementById('doctor-id').value = doctor.id;
        document.getElementById('name').value = doctor.name;
        document.getElementById('specialization').value = doctor.specialization;
        document.getElementById('phone').value = doctor.phone;
        document.getElementById('form-error').classList.add('d-none');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('doctorModal')).show();
    }

    async function saveDoctor() {
        const id = document.getElementById('doctor-id').value;
        const name = document.getElementById('name').value.trim();
        const specialization = document.getElementById('specialization').value.trim();
        const phone = document.getElementById('phone').value.trim();
        const errorDiv = document.getElementById('form-error');
        const saveBtn = document.getElementById('save-btn');

        if (!name) { errorDiv.classList.remove('d-none'); errorDiv.textContent = 'Name is required'; return; }
        if (!specialization) { errorDiv.classList.remove('d-none'); errorDiv.textContent = 'Specialization is required'; return; }
        if (!phone) { errorDiv.classList.remove('d-none'); errorDiv.textContent = 'Phone is required'; return; }

        errorDiv.classList.add('d-none');
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        try {
            const url = id ? `/api/doctors/${id}` : '/api/doctors';
            const method = id ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                body: JSON.stringify({ name, specialization, phone })
            });

            const result = await response.json();

            if (response.ok) {
                bootstrap.Modal.getInstance(document.getElementById('doctorModal')).hide();
                loadDoctors();
            } else {
                errorDiv.classList.remove('d-none');
                errorDiv.textContent = result.message;
            }
        } catch (err) {
            errorDiv.classList.remove('d-none');
            errorDiv.textContent = 'Something went wrong. Please try again.';
        } finally {
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save';
        }
    }

    function showToggleConfirm(id, isActive, name) {
        toggleTargetId = id;
        toggleIsActive = isActive;
        document.getElementById('deactivate-title').textContent = isActive ? 'Deactivate Doctor' : 'Reactivate Doctor';
        document.getElementById('deactivate-body').textContent = isActive
            ? `Are you sure you want to deactivate ${name}? They won't appear in appointment bookings.`
            : `Are you sure you want to reactivate ${name}?`;
        const btn = document.getElementById('deactivate-btn');
        btn.style.background = isActive ? '#ff4444' : '#00ff88';
        btn.style.color = '#0a0a0a';
        btn.textContent = isActive ? 'Deactivate' : 'Reactivate';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('deactivateModal')).show();
    }

    async function confirmToggle() {
        if (!toggleTargetId) return;

        const url = `/api/doctors/${toggleTargetId}/${toggleIsActive ? 'deactivate' : 'reactivate'}`;

        try {
            const response = await fetch(url, {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${token}` }
            });

            bootstrap.Modal.getInstance(document.getElementById('deactivateModal')).hide();

            if (response.ok) {
                toggleTargetId = null;
                loadDoctors();
            } else {
                alert('Failed to update doctor status');
            }
        } catch (err) {
            alert('Something went wrong. Please try again.');
        }
    }

    loadDoctors();
</script>
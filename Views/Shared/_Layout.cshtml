<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HealthcareCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/css/site.css" />
    <script>
        const token = localStorage.getItem('jwt');
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<nav class="navbar-crm d-flex justify-content-between align-items-center" id="main-navbar" style="display:none;">
    <div class="d-flex align-items-center gap-4">
        <a href="/Home/Index" class="navbar-brand-crm">
            <svg width="22" height="12" viewBox="0 0 48 24" xmlns="http://www.w3.org/2000/svg" style="margin-right:0.4rem;">
                <path d="M0,12 L10,12 L14,3 L18,21 L22,12 L26,12 L30,18 L34,6 L38,12 L48,12"
                      fill="none" stroke="#00ff88" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Healthcare<span>CRM</span>
        </a>
        <div class="d-flex gap-1">
            <a href="/Home/Index" class="nav-link-crm" id="nav-dashboard">Dashboard</a>
            <a href="/Patients" class="nav-link-crm" id="nav-patients">Patients</a>
            <a href="/Doctors" class="nav-link-crm" id="nav-doctors">Doctors</a>
            <a href="/Appointments" class="nav-link-crm" id="nav-appointments">Appointments</a>
            <a href="/Admin/Users" class="nav-link-crm" id="nav-admin" style="display:none;">Admin</a>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <span class="user-badge" id="user-email">User</span>
        <span id="role-badge" class="role-badge-staff">Staff</span>
        <button class="btn-logout" onclick="logout()">
            <i class="bi bi-box-arrow-right me-1"></i>Logout
        </button>
    </div>
</nav>

<main>
    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const navbar = document.getElementById('main-navbar');
    const roleBadge = document.getElementById('role-badge');

    if (token) {
        navbar.style.display = 'flex';

        let userRole = 'Staff';
        try {
            const payload = JSON.parse(atob(token.split('.')[1]));
            const email = payload['http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress'];
            if (email) document.getElementById('user-email').textContent = email;
            userRole = payload['http://schemas.microsoft.com/ws/2008/06/identity/claims/role'] || 'Staff';
        } catch (e) {}

        if (userRole === 'Admin') {
            roleBadge.textContent = 'Admin';
            roleBadge.className = 'role-badge-admin';
            document.getElementById('nav-admin').style.display = 'inline-block';
        } else {
            roleBadge.textContent = 'Staff';
            roleBadge.className = 'role-badge-staff';
        }
    }

    const path = window.location.pathname.toLowerCase();
    if (path.includes('/admin')) document.getElementById('nav-admin').classList.add('active');
    else if (path.includes('/patients')) document.getElementById('nav-patients').classList.add('active');
    else if (path.includes('/doctors')) document.getElementById('nav-doctors').classList.add('active');
    else if (path.includes('/appointments')) document.getElementById('nav-appointments').classList.add('active');
    else document.getElementById('nav-dashboard').classList.add('active');

    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
        try {
            const response = await originalFetch(...args);
            if (response.status === 403) {
                window.location.href = '/Home/AccessDenied';
            }
            return response;
        } catch (err) {
            console.error('Network error:', err);
            if (!document.getElementById('network-error-banner')) {
                const banner = document.createElement('div');
                banner.id = 'network-error-banner';
                banner.className = 'network-error-banner';
                banner.textContent = 'Could not connect to server. Please check your connection and try again.';
                document.body.prepend(banner);
                setTimeout(() => banner.remove(), 5000);
            }
            throw err;
        }
    };

    async function logout() {
        try {
            await fetch('/api/auth/logout', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` }
            });
        } catch (e) {}
        finally {
            localStorage.removeItem('jwt');
            window.location.href = '/';
        }
    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
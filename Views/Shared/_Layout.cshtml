<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HealthcareCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css" />
    <script>
        const token = localStorage.getItem('jwt');
    </script>
    <style>
        body { background: #0a0a0a; font-family: 'Segoe UI', sans-serif; }

        .navbar-crm {
            background: #0a0a0a;
            padding: 0.9rem 2rem;
            border-bottom: 1px solid #1a1a1a;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar-brand-crm {
            font-size: 1.2rem;
            font-weight: 800;
            color: white !important;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .navbar-brand-crm span { color: #00ff88; }

        .nav-link-crm {
            color: #888 !important;
            font-size: 0.9rem;
            font-weight: 500;
            text-decoration: none;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            transition: color 0.2s, background 0.2s;
        }

        .nav-link-crm:hover {
            color: white !important;
            background: #1a1a1a;
        }

        .nav-link-crm.active {
            color: #00ff88 !important;
            background: #0d1f15;
        }

        .btn-logout {
            background: transparent;
            border: 1px solid #333;
            color: #888;
            padding: 0.4rem 1rem;
            border-radius: 6px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: border-color 0.2s, color 0.2s;
        }

        .btn-logout:hover { border-color: #ff4444; color: #ff4444; }

        .user-badge {
            background: #0d1f15;
            border: 1px solid #1a3d26;
            color: #00ff88;
            padding: 0.3rem 0.8rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .role-badge-admin {
            background: #1f0a00;
            border: 1px solid #ff6600;
            color: #ff6600;
            padding: 0.3rem 0.8rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .role-badge-staff {
            background: #0d1f15;
            border: 1px solid #1a3d26;
            color: #00ff88;
            padding: 0.3rem 0.8rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<nav class="navbar-crm d-flex justify-content-between align-items-center" id="main-navbar" style="display:none;">
    <div class="d-flex align-items-center gap-4">
        <a href="/Home/Index" class="navbar-brand-crm">Healthcare<span>CRM</span></a>
        <div class="d-flex gap-1">
            <a href="/Home/Index" class="nav-link-crm" id="nav-dashboard">Dashboard</a>
            <a href="/Patients" class="nav-link-crm" id="nav-patients">Patients</a>
            <a href="/Doctors" class="nav-link-crm" id="nav-doctors">Doctors</a>
            <a href="/Appointments" class="nav-link-crm" id="nav-appointments">Appointments</a>
            <a href="/Admin/Users" class="nav-link-crm" id="nav-admin" style="display:none;">⚙️ Admin</a>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <span class="user-badge" id="user-email">👤 User</span>
        <span id="role-badge" class="role-badge-staff">Staff</span>
        <button class="btn-logout" onclick="logout()">Logout</button>
    </div>
</nav>

<main>
    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const navbar = document.getElementById('main-navbar');
    const roleBadge = document.getElementById('role-badge');

    if (token) {
        navbar.style.display = 'flex';

        // Decode JWT
        let userRole = 'Staff';
        try {
            const payload = JSON.parse(atob(token.split('.')[1]));

            // Set email
            const email = payload['http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress'];
            if (email) document.getElementById('user-email').textContent = '👤 ' + email;

            // Set role
            userRole = payload['http://schemas.microsoft.com/ws/2008/06/identity/claims/role'] || 'Staff';

        } catch (e) {}

        // Update role badge
        if (userRole === 'Admin') {
            roleBadge.textContent = 'Admin';
            roleBadge.className = 'role-badge-admin';
            document.getElementById('nav-admin').style.display = 'inline-block';
        } else {
            roleBadge.textContent = 'Staff';
            roleBadge.className = 'role-badge-staff';
        }
    }

    // Highlight active nav link
    const path = window.location.pathname.toLowerCase();
    if (path.includes('/admin')) document.getElementById('nav-admin').classList.add('active');
    else if (path.includes('/patients')) document.getElementById('nav-patients').classList.add('active');
    else if (path.includes('/doctors')) document.getElementById('nav-doctors').classList.add('active');
    else if (path.includes('/appointments')) document.getElementById('nav-appointments').classList.add('active');
    else document.getElementById('nav-dashboard').classList.add('active');

    async function logout() {
        try {
            await fetch('/api/auth/logout', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` }
            });
        } catch (e) {}
        finally {
            localStorage.removeItem('jwt');
            window.location.href = '/';
        }
    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@{
    ViewData["Title"] = "HealthcareCRM";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HealthcareCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #0a0a0a;
            color: #ffffff;
            font-family: 'Segoe UI', sans-serif;
            overflow-x: hidden;
        }

        /* Navbar */
        nav {
            padding: 1.5rem 3rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #1a1a1a;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(10,10,10,0.95);
            backdrop-filter: blur(10px);
            z-index: 100;
        }

        .logo {
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .logo span { color: #00ff88; }

        .logo-heartbeat {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }

        .nav-links { display: flex; gap: 1rem; align-items: center; }

        .btn-login {
            background: transparent;
            border: 1px solid #333;
            color: white;
            padding: 0.5rem 1.5rem;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.9rem;
            transition: border-color 0.2s;
        }

        .btn-login:hover { border-color: #00ff88; color: #00ff88; }

        .btn-start {
            background: #00ff88;
            border: none;
            color: #0a0a0a;
            padding: 0.5rem 1.5rem;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 700;
            transition: opacity 0.2s;
        }

        .btn-start:hover { opacity: 0.85; color: #0a0a0a; }

        /* Hero */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 8rem 3rem 4rem;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(0,255,136,0.06) 0%, transparent 70%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
        }

        .hero-pulse-wrap {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 10%;
            height: 220px;
            pointer-events: none;
            z-index: 0;
        }

        .hero-pulse-wrap svg { width: 100%; height: 100%; display: block; }

        #hero-pulse-path {
            fill: none;
            stroke: #00ff88;
            stroke-width: 1.5;
            stroke-linecap: round;
            stroke-linejoin: round;
            opacity: 0.28;
        }

        .hero-content {
            position: relative;
            z-index: 1;
        }

        .tag {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            background: #111;
            border: 1px solid #222;
            color: #00ff88;
            padding: 0.4rem 1rem;
            border-radius: 100px;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 2rem;
        }

        .heartbeat-icon {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
            filter: drop-shadow(0 0 4px rgba(0,255,136,0.7));
        }

        .hero h1 {
            font-size: clamp(3rem, 7vw, 6rem);
            font-weight: 900;
            line-height: 1.0;
            letter-spacing: -3px;
            margin-bottom: 1.5rem;
        }

        .hero h1 .accent { color: #00ff88; }

        .hero p {
            font-size: 1.15rem;
            color: #888;
            max-width: 480px;
            line-height: 1.7;
            margin-bottom: 2.5rem;
        }

        .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }

        .btn-primary-custom {
            background: #00ff88;
            color: #0a0a0a;
            border: none;
            padding: 0.9rem 2.5rem;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 800;
            text-decoration: none;
            transition: opacity 0.2s, transform 0.2s;
            display: inline-block;
        }

        .btn-primary-custom:hover {
            opacity: 0.9;
            transform: translateY(-2px);
            color: #0a0a0a;
        }

        .btn-secondary-custom {
            background: transparent;
            color: white;
            border: 1px solid #333;
            padding: 0.9rem 2.5rem;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            transition: border-color 0.2s;
            display: inline-block;
        }

        .btn-secondary-custom:hover { border-color: #555; color: white; }

        /* Live status indicator */
        .live-status {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            margin-top: 2.2rem;
            color: #666;
            font-size: 0.85rem;
            letter-spacing: 0.3px;
        }

        .status-dot-wrap {
            position: relative;
            display: inline-flex;
            width: 8px;
            height: 8px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #00ff88;
            display: block;
        }

        .status-ping {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: #00ff88;
            animation: ping 1.8s cubic-bezier(0,0,0.2,1) infinite;
        }

        @@keyframes ping {
            0% { transform: scale(1); opacity: 0.7; }
            100% { transform: scale(2.6); opacity: 0; }
        }

        /* Stats bar */
        .stats-bar {
            border-top: 1px solid #111;
            border-bottom: 1px solid #111;
            padding: 3rem 0;
            background: #050505;
        }

        .stat-item { text-align: center; }

        .stat-number {
            font-size: 2.8rem;
            font-weight: 900;
            color: #00ff88;
            letter-spacing: -2px;
        }

        .stat-label {
            color: #555;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 0.3rem;
        }

        /* Features */
        .features {
            padding: 8rem 3rem;
            background: #0a0a0a;
        }

        .section-label {
            color: #00ff88;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .section-title {
            font-size: clamp(2rem, 4vw, 3.5rem);
            font-weight: 900;
            letter-spacing: -2px;
            margin-bottom: 1rem;
        }

        .section-subtitle { color: #555; font-size: 1rem; max-width: 400px; }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1px;
            background: #111;
            border: 1px solid #111;
            border-radius: 16px;
            overflow: hidden;
            margin-top: 4rem;
        }

        .feature-item {
            background: #0a0a0a;
            padding: 2.5rem;
            transition: background 0.2s;
        }

        .feature-item:hover { background: #111; }

        .feature-number {
            font-size: 0.75rem;
            color: #333;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 1.5rem;
        }

        .feature-icon-box {
            width: 48px;
            height: 48px;
            background: #111;
            border: 1px solid #222;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            margin-bottom: 1.2rem;
        }

        .feature-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 0.7rem;
        }

        .feature-desc { color: #555; font-size: 0.9rem; line-height: 1.6; }

        /* CTA */
        .cta {
            padding: 6rem 3rem 8rem;
            text-align: center;
            background: #050505;
            border-top: 1px solid #111;
        }

        .cta-pulse {
            display: block;
            width: 100%;
            max-width: 460px;
            height: 40px;
            margin: 0 auto 2.5rem;
        }

        #cta-pulse-path {
            fill: none;
            stroke: #00ff88;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            filter: drop-shadow(0 0 6px rgba(0,255,136,0.55));
        }

        .cta h2 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 900;
            letter-spacing: -2px;
            margin-bottom: 1.5rem;
        }

        .cta h2 span { color: #00ff88; }
        .cta p { color: #555; margin-bottom: 2.5rem; font-size: 1rem; }

        /* Footer */
        footer {
            padding: 2rem 3rem;
            border-top: 1px solid #111;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #333;
            font-size: 0.85rem;
        }

        @@media (max-width: 860px) {
            .feature-grid { grid-template-columns: 1fr; }
            .hero-pulse-wrap { opacity: 0.6; }
        }

        @@media (prefers-reduced-motion: reduce) {
            .status-ping { animation: none; }
            #hero-pulse-path, #cta-pulse-path { stroke-dashoffset: 0 !important; }
            #hero-dot { display: none; }
        }
    </style>
</head>
<body>

<!-- Navbar -->
<nav>
    <div class="logo">
        <svg class="logo-heartbeat" viewBox="0 0 48 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,12 L10,12 L14,3 L18,21 L22,12 L26,12 L30,18 L34,6 L38,12 L48,12"
                  fill="none" stroke="#00ff88" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Healthcare<span>CRM</span>
    </div>
    <div class="nav-links">
        <a href="/Account/Login" class="btn-login">Login</a>
        <a href="/Account/Register" class="btn-start">Get Started →</a>
    </div>
</nav>

<!-- Hero -->
<section class="hero">
    <div class="hero-pulse-wrap" aria-hidden="true">
        <svg viewBox="0 0 1200 220" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <filter id="glow-filter" x="-50%" y="-50%" width="200%" height="200%">
                    <feGaussianBlur stdDeviation="3" result="blur" />
                    <feMerge>
                        <feMergeNode in="blur" />
                        <feMergeNode in="SourceGraphic" />
                    </feMerge>
                </filter>
            </defs>
            <path id="hero-pulse-path"
                  d="M0,110 L900,110 L920,110 L940,25 L960,195 L980,60 L1000,110 L1200,110" />
            <circle id="hero-dot" r="5" fill="#00ff88" filter="url(#glow-filter)">
                <animateMotion dur="3.2s" repeatCount="indefinite"
                                path="M0,110 L900,110 L920,110 L940,25 L960,195 L980,60 L1000,110 L1200,110" />
            </circle>
        </svg>
    </div>

    <div class="hero-content">
        <div class="tag">
            <svg class="heartbeat-icon" viewBox="0 0 48 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M0,12 L10,12 L14,3 L18,21 L22,12 L26,12 L30,18 L34,6 L38,12 L48,12"
                      fill="none" stroke="#00ff88" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Healthcare Management System
        </div>
        <h1>
            Manage Your<br>
            Clinic With<br>
            <span class="accent">Precision.</span>
        </h1>
        <p>
            A powerful CRM built for modern healthcare facilities.
            Patients, doctors, appointments — all in one place.
        </p>
        <div class="hero-actions">
            <a href="/Account/Register" class="btn-primary-custom">Start for Free →</a>
            <a href="/Account/Login" class="btn-secondary-custom">Sign In</a>
        </div>
        <div class="live-status">
            <span class="status-dot-wrap">
                <span class="status-dot"></span>
                <span class="status-ping"></span>
            </span>
            All systems operational
        </div>
    </div>
</section>

<!-- Stats -->
<div class="stats-bar">
    <div class="container">
        <div class="row g-4">
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-number">500+</div>
                    <div class="stat-label">Patients Managed</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-number">50+</div>
                    <div class="stat-label">Doctors Onboarded</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-number">1200+</div>
                    <div class="stat-label">Appointments Booked</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-number">99%</div>
                    <div class="stat-label">Uptime Guaranteed</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Features -->
<section class="features">
    <div class="container">
        <div class="section-label">Features</div>
        <h2 class="section-title">Built for real<br>clinical workflows.</h2>
        <p class="section-subtitle">Everything a modern healthcare facility needs — nothing it doesn't.</p>

        <div class="feature-grid">
            <div class="feature-item">
                <div class="feature-number">01</div>
                <div class="feature-icon-box">👥</div>
                <div class="feature-title">Patient Management</div>
                <div class="feature-desc">Full CRUD with search by name, phone, or date of birth. Paginated list with detail view.</div>
            </div>
            <div class="feature-item">
                <div class="feature-number">02</div>
                <div class="feature-icon-box">👨‍⚕️</div>
                <div class="feature-title">Doctor Scheduling</div>
                <div class="feature-desc">Add, edit, and manage doctors. Soft deactivate without losing historical records.</div>
            </div>
            <div class="feature-item">
                <div class="feature-number">03</div>
                <div class="feature-icon-box">📅</div>
                <div class="feature-title">Appointment Booking</div>
                <div class="feature-desc">Book appointments in seconds. Filter by status — Pending, Confirmed, or Cancelled.</div>
            </div>
            <div class="feature-item">
                <div class="feature-number">04</div>
                <div class="feature-icon-box">🔒</div>
                <div class="feature-title">Secure Auth</div>
                <div class="feature-desc">JWT authentication with protected routes. localStorage token management.</div>
            </div>
            <div class="feature-item">
                <div class="feature-number">05</div>
                <div class="feature-icon-box">📖</div>
                <div class="feature-title">Swagger Docs</div>
                <div class="feature-desc">Every endpoint documented and testable from the browser at /swagger.</div>
            </div>
            <div class="feature-item">
                <div class="feature-number">06</div>
                <div class="feature-icon-box">🛡️</div>
                <div class="feature-title">Data Integrity</div>
                <div class="feature-desc">Server-side validation on all endpoints. CodeRabbit reviewed for XSS and security.</div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta">
    <svg class="cta-pulse" viewBox="0 0 460 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path id="cta-pulse-path"
              d="M0,20 L170,20 L190,20 L206,4 L218,36 L230,10 L242,20 L460,20" />
    </svg>
    <h2>Ready to get<br><span>started?</span></h2>
    <p>Join HealthcareCRM and modernize your clinic today.</p>
    <a href="/Account/Register" class="btn-primary-custom">Create Account →</a>
</section>

<!-- Footer -->
<footer>
    <div>© 2026 HealthcareCRM</div>
    <div>Built by Sohaib — Friendsware Solutions Internship 2026</div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    (function () {
        function drawOnLoad(path) {
            if (!path) return;
            var len = path.getTotalLength();
            path.style.strokeDasharray = len;
            path.style.strokeDashoffset = len;
            requestAnimationFrame(function () {
                path.style.transition = 'stroke-dashoffset 1.6s ease-out';
                path.style.strokeDashoffset = '0';
            });
        }

        drawOnLoad(document.getElementById('hero-pulse-path'));

        var ctaPath = document.getElementById('cta-pulse-path');
        if (ctaPath) {
            var ctaLen = ctaPath.getTotalLength();
            ctaPath.style.strokeDasharray = ctaLen;
            ctaPath.style.strokeDashoffset = ctaLen;

            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        ctaPath.style.transition = 'stroke-dashoffset 1.2s ease-out';
                        ctaPath.style.strokeDashoffset = '0';
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.4 });
            observer.observe(ctaPath);
        }
    })();
</script>

</body>
</html>

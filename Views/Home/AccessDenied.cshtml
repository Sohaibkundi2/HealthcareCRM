@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied — HealthcareCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body style="background:#0a0a0a; min-height:100vh; display:flex; align-items:center; justify-content:center;">

<div style="text-align:center; padding: 2rem;">
    <div style="font-size: 5rem; margin-bottom: 1rem;">🔒</div>
    <h1 style="font-size: 3rem; font-weight: 900; letter-spacing: -2px; color: white; margin-bottom: 0.5rem;">
        403
    </h1>
    <h2 style="font-size: 1.2rem; font-weight: 600; color: #ff4444; margin-bottom: 1rem;">
        Access Denied
    </h2>
    <p style="color: #555; margin-bottom: 2rem; max-width: 400px;">
        You don't have permission to access this page. 
        This area is restricted to Admin users only.
    </p>
    <a href="/Home/Index" class="btn-primary-crm">← Back to Dashboard</a>
</div>

<script>
    const token = localStorage.getItem('jwt');
    if (!token) window.location.href = '/Account/Login';
</script>

</body>
</html>
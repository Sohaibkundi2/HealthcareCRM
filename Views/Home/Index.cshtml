@{
    ViewData["Title"] = "Dashboard";
}

<style>
    body { background: #0a0a0a !important; color: white; }

    .stat-card {
        background: #111;
        border: 1px solid #1a1a1a;
        border-radius: 12px;
        padding: 1.5rem;
        transition: border-color 0.2s, transform 0.2s;
    }

    .stat-card:hover {
        border-color: #00ff88;
        transform: translateY(-2px);
    }

    .stat-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #555;
        font-weight: 700;
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 900;
        letter-spacing: -2px;
        color: white;
        margin: 0.3rem 0;
    }

    .stat-link {
        font-size: 0.8rem;
        color: #00ff88;
        text-decoration: none;
    }

    .stat-link:hover { text-decoration: underline; color: #00ff88; }

    .stat-icon { font-size: 2rem; }

    .section-title {
        font-size: 1rem;
        font-weight: 700;
        color: white;
        margin-bottom: 1rem;
    }

    .quick-action {
        background: #111;
        border: 1px solid #222;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: border-color 0.2s, color 0.2s;
        display: inline-block;
    }

    .quick-action:hover { border-color: #00ff88; color: #00ff88; }

    .recent-card {
        background: #111;
        border: 1px solid #1a1a1a;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .table { color: white; }
    .table thead th {
        color: #555;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-color: #1a1a1a;
        font-weight: 700;
    }

    .table td { border-color: #1a1a1a; font-size: 0.9rem; vertical-align: middle; }
    .table tbody tr:hover { background: #151515; }

    .table-dark-custom {
    --bs-table-bg: transparent;
    --bs-table-striped-bg: #151515;
    --bs-table-hover-bg: #151515;
    --bs-table-border-color: #1a1a1a;
    --bs-table-color: white;
}

    .welcome-name { color: #00ff88; }

    .date-badge {
        background: #111;
        border: 1px solid #222;
        color: #555;
        padding: 0.4rem 1rem;
        border-radius: 8px;
        font-size: 0.8rem;
    }

    .divider {
        border-color: #1a1a1a;
        margin: 1.5rem 0;
    }
</style>

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="text-muted mb-0" style="font-size: 0.85rem; color: #555 !important;">Good day 👋</p>
            <h2 class="fw-bold mb-0" id="welcome-msg">Dashboard</h2>
        </div>
        <div class="date-badge" id="current-date"></div>
    </div>

    <hr class="divider">

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Patients</div>
                        <div class="stat-number" id="stat-patients">—</div>
                        <a href="/Patients" class="stat-link">View all →</a>
                    </div>
                    <div class="stat-icon">👥</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Doctors</div>
                        <div class="stat-number" id="stat-doctors">—</div>
                        <a href="/Doctors" class="stat-link">View all →</a>
                    </div>
                    <div class="stat-icon">👨‍⚕️</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Pending</div>
                        <div class="stat-number" id="stat-pending">—</div>
                        <a href="/Appointments" class="stat-link">View all →</a>
                    </div>
                    <div class="stat-icon">⏳</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Confirmed</div>
                        <div class="stat-number" id="stat-confirmed">—</div>
                        <a href="/Appointments" class="stat-link">View all →</a>
                    </div>
                    <div class="stat-icon">✅</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="mb-4">
        <div class="section-title">Quick Actions</div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/Patients" class="quick-action">+ Add Patient</a>
            <a href="/Doctors" class="quick-action">+ Add Doctor</a>
            <a href="/Appointments/Book" class="quick-action">+ Book Appointment</a>
            <a href="/swagger" target="_blank" class="quick-action">📖 API Docs</a>
        </div>
    </div>

    <!-- Recent Appointments -->
    <div class="recent-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="section-title mb-0">Recent Appointments</div>
            <a href="/Appointments" class="stat-link">View all →</a>
        </div>

        <div id="recent-loading" class="text-center py-3">
            <div class="spinner-border spinner-border-sm" style="color: #00ff88;"></div>
        </div>

        <table class="table table-dark-custom d-none" id="recent-table">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="recent-tbody"></tbody>
        </table>

        <div id="recent-empty" class="text-center py-3 d-none" style="color: #555;">
            No appointments yet.
        </div>
    </div>
</div>

<script>
    if (!token) window.location.href = '/Account/Login';

    // Set date
    document.getElementById('current-date').textContent = new Date().toLocaleDateString('en-US', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    });

    // Decode name from JWT
    try {
        const payload = JSON.parse(atob(token.split('.')[1]));
        const name = payload['http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name'];
        if (name) document.getElementById('welcome-msg').innerHTML = `Welcome back, <span class="welcome-name">${name}</span>`;
    } catch (e) {}

    async function loadDashboard() {
        try {
            // Patients count
            const pRes = await fetch('/api/patients?pageSize=1000', {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const pData = await pRes.json();
            document.getElementById('stat-patients').textContent = pData.totalCount ?? 0;

            // Doctors count
            const dRes = await fetch('/api/doctors', {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const dData = await dRes.json();
            document.getElementById('stat-doctors').textContent = dData.data?.length ?? 0;

            // Appointments
            const aRes = await fetch('/api/appointments', {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const aData = await aRes.json();
            const appointments = aData.data || [];

            document.getElementById('stat-pending').textContent =
                appointments.filter(a => a.status === 'Pending').length;
            document.getElementById('stat-confirmed').textContent =
                appointments.filter(a => a.status === 'Confirmed').length;

            // Recent 5
            const recent = appointments.slice(0, 5);
            document.getElementById('recent-loading').classList.add('d-none');

            if (recent.length === 0) {
                document.getElementById('recent-empty').classList.remove('d-none');
                return;
            }

            document.getElementById('recent-table').classList.remove('d-none');
            document.getElementById('recent-tbody').innerHTML = recent.map(a => `
                <tr>
                    <td>${a.patient?.fullName || '—'}</td>
                    <td>${a.doctor?.name || '—'}</td>
                    <td>${new Date(a.appointmentDate).toLocaleDateString()}</td>
                    <td>
                        <span style="
                            padding: 0.25rem 0.75rem;
                            border-radius: 100px;
                            font-size: 0.75rem;
                            font-weight: 700;
                            background: ${a.status === 'Confirmed' ? '#0d1f15' : a.status === 'Cancelled' ? '#1f0d0d' : '#1f1a0d'};
                            color: ${a.status === 'Confirmed' ? '#00ff88' : a.status === 'Cancelled' ? '#ff4444' : '#ffc107'};
                            border: 1px solid ${a.status === 'Confirmed' ? '#1a3d26' : a.status === 'Cancelled' ? '#3d1a1a' : '#3d3010'};
                        ">${a.status}</span>
                    </td>
                </tr>
            `).join('');

        } catch (err) {
            console.error('Dashboard error:', err);
        }
    }

    loadDashboard();
</script>
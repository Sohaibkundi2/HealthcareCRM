@{
    ViewData["Title"] = "User Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title mb-0">⚙️ User Management</h2>
        <span style="color:#555; font-size:0.85rem;">Admin only</span>
    </div>

    <div id="access-denied" class="access-denied d-none">
        <div>🔒</div>
        <p>Access Denied — Admin only</p>
        <a href="/Home/Index" style="color:#00ff88;">← Back to Dashboard</a>
    </div>

    <div id="loading" class="text-center py-5">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2" style="color:#555;">Loading users...</p>
    </div>

    <div class="dark-card d-none" id="users-card">
        <table class="dark-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="users-table"></tbody>
        </table>
    </div>
</div>

<!-- Change Role Modal -->
<div class="modal fade" id="roleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Change Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="role-user-id" />
                <label class="dark-label">Select Role</label>
                <select id="role-select" class="dark-select">
                    <option value="Admin">Admin</option>
                    <option value="Staff">Staff</option>
                </select>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel-modal" data-bs-dismiss="modal">Cancel</button>
                <button class="btn-save" onclick="confirmRoleChange()">Update Role</button>
            </div>
        </div>
    </div>
</div>

<script>
    if (!token) window.location.href = '/Account/Login';

    // Check role from JWT
    let userRole = 'Staff';
    try {
        const payload = JSON.parse(atob(token.split('.')[1]));
        userRole = payload['http://schemas.microsoft.com/ws/2008/06/identity/claims/role'] || 'Staff';
    } catch (e) {}

    // Block non-admin users
    if (userRole !== 'Admin') {
        document.getElementById('loading').classList.add('d-none');
        document.getElementById('access-denied').classList.remove('d-none');
    } else {
        loadUsers();
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(text || ''));
        return div.innerHTML;
    }

    async function loadUsers() {
        try {
            const response = await fetch('/api/admin/users', {
                headers: { 'Authorization': `Bearer ${token}` }
            });

            if (response.status === 403) {
                document.getElementById('loading').classList.add('d-none');
                document.getElementById('access-denied').classList.remove('d-none');
                return;
            }

            const result = await response.json();

            document.getElementById('loading').classList.add('d-none');
            document.getElementById('users-card').classList.remove('d-none');

            document.getElementById('users-table').innerHTML = result.data.map((u, i) => `
                <tr>
                    <td style="color:#555;">${i + 1}</td>
                    <td style="font-weight:600;">${escapeHtml(u.fullName)}</td>
                    <td style="color:#888;">${escapeHtml(u.email)}</td>
                    <td>
                        <span class="${u.role === 'Admin' ? 'badge-admin' : 'badge-staff'}">
                            ${u.role}
                        </span>
                    </td>
                    <td>
                        <button class="btn-action" onclick="showRoleModal(${u.id}, '${u.role}')">Change Role</button>
                    </td>
                </tr>
            `).join('');

        } catch (err) {
            document.getElementById('loading').innerHTML =
                '<p style="color:#ff6b6b; text-align:center;">Failed to load users.</p>';
        }
    }

    function showRoleModal(id, currentRole) {
        document.getElementById('role-user-id').value = id;
        document.getElementById('role-select').value = currentRole;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('roleModal')).show();
    }

    async function confirmRoleChange() {
        const id = document.getElementById('role-user-id').value;
        const role = document.getElementById('role-select').value;

        try {
            const response = await fetch(`/api/admin/users/${id}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({ role })
            });

            bootstrap.Modal.getInstance(document.getElementById('roleModal')).hide();

            if (response.ok) {
                loadUsers();
            } else {
                alert('Failed to update role');
            }
        } catch (err) {
            alert('Something went wrong');
        }
    }
</script>
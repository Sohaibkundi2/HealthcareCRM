@{
    ViewData["Title"] = "User Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title mb-0">
            <i class="bi bi-gear icon-accent me-2"></i>User Management
        </h2>
        <a href="/Admin/AuditLog" class="btn-ghost-crm">
            <i class="bi bi-journal-text me-1"></i>Audit Log
        </a>
    </div>

    <div id="access-denied" class="access-denied d-none">
        <i class="bi bi-shield-lock icon-danger"></i>
        <p>Access Denied — Admin only</p>
        <a href="/Home/Index" style="color:#00ff88;">← Back to Dashboard</a>
    </div>

    <div id="loading" class="text-center py-5">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2" style="color:#555;">Loading users...</p>
    </div>

    <div class="dark-card d-none" id="users-card">
        <table class="dark-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="users-table"></tbody>
        </table>
    </div>
</div>

<!-- Change Role Modal -->
<div class="modal fade" id="roleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Change Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="role-user-id" />
                <label class="dark-label">Select Role</label>
                <select id="role-select" class="dark-select">
                    <option value="Admin">Admin</option>
                    <option value="Staff">Staff</option>
                </select>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel-modal" data-bs-dismiss="modal">Cancel</button>
                <button class="btn-save" onclick="confirmRoleChange()">Update Role</button>
            </div>
        </div>
    </div>
</div>

<!-- Toggle Active Confirm Modal -->
<div class="modal fade" id="toggleActiveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="toggle-active-title">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="toggle-active-body" style="color:#aaa;">
                Are you sure?
            </div>
            <div class="modal-footer">
                <button class="btn-cancel-modal" data-bs-dismiss="modal">Cancel</button>
                <button id="toggle-active-btn" class="btn-save" onclick="confirmToggleActive()">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
    if (!token) window.location.href = '/Account/Login';

    // Check role from JWT
    let userRole = 'Staff';
    try {
        const payload = JSON.parse(atob(token.split('.')[1]));
        userRole = payload['http://schemas.microsoft.com/ws/2008/06/identity/claims/role'] || 'Staff';
    } catch (e) {}

    // Block non-admin users
    if (userRole !== 'Admin') {
        document.getElementById('loading').classList.add('d-none');
        document.getElementById('access-denied').classList.remove('d-none');
    } else {
        loadUsers();
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(text || ''));
        return div.innerHTML;
    }

    async function loadUsers() {
        try {
            const response = await fetch('/api/admin/users', {
                headers: { 'Authorization': `Bearer ${token}` }
            });

            if (response.status === 403) {
                document.getElementById('loading').classList.add('d-none');
                document.getElementById('access-denied').classList.remove('d-none');
                return;
            }

            const result = await response.json();

            document.getElementById('loading').classList.add('d-none');
            document.getElementById('users-card').classList.remove('d-none');

            document.getElementById('users-table').innerHTML = result.data.map((u, i) => `
                <tr>
                    <td style="color:#555;">${i + 1}</td>
                    <td style="font-weight:600;">${escapeHtml(u.fullName)}</td>
                    <td style="color:#888;">${escapeHtml(u.email)}</td>
                    <td>
                        <span class="${u.role === 'Admin' ? 'badge-admin' : 'badge-staff'}">
                            ${u.role}
                        </span>
                    </td>
                    <td>
                        <span class="${u.isActive ? 'badge-active' : 'badge-inactive'}">
                            ${u.isActive ? 'Active' : 'Inactive'}
                        </span>
                    </td>
                    <td>
                        <button class="btn-action me-1" onclick="showRoleModal(${u.id}, '${u.role}')">Change Role</button>
                        <button class="btn-action ${u.isActive ? 'danger' : ''}" 
                            onclick="toggleActive(${u.id}, ${u.isActive}, '${escapeHtml(u.fullName)}')">
                            ${u.isActive ? 'Deactivate' : 'Activate'}
                        </button>
                    </td>
                </tr>
            `).join('');

        } catch (err) {
            document.getElementById('loading').innerHTML =
                '<p style="color:#ff6b6b; text-align:center;">Failed to load users.</p>';
        }
    }

    function showRoleModal(id, currentRole) {
        document.getElementById('role-user-id').value = id;
        document.getElementById('role-select').value = currentRole;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('roleModal')).show();
    }

    async function confirmRoleChange() {
        const id = document.getElementById('role-user-id').value;
        const role = document.getElementById('role-select').value;

        try {
            const response = await fetch(`/api/admin/users/${id}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({ role })
            });

            bootstrap.Modal.getInstance(document.getElementById('roleModal')).hide();

            if (response.ok) {
                loadUsers();
            } else {
                alert('Failed to update role');
            }
        } catch (err) {
            alert('Something went wrong');
        }
    }

    let toggleActiveTargetId = null;
    let toggleActiveIsActive = false;

    function toggleActive(id, isActive, name) {
        toggleActiveTargetId = id;
        toggleActiveIsActive = isActive;
        document.getElementById('toggle-active-title').textContent = isActive ? 'Deactivate User' : 'Activate User';
        document.getElementById('toggle-active-body').textContent = isActive
            ? `Are you sure you want to deactivate ${name}? They will not be able to login.`
            : `Are you sure you want to activate ${name}?`;
        const btn = document.getElementById('toggle-active-btn');
        btn.style.background = isActive ? '#ff4444' : '#00ff88';
        btn.style.color = '#0a0a0a';
        btn.textContent = isActive ? 'Deactivate' : 'Activate';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('toggleActiveModal')).show();
    }

    async function confirmToggleActive() {
        if (!toggleActiveTargetId) return;

        try {
            const response = await fetch(`/api/admin/users/${toggleActiveTargetId}/toggle-active`, {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${token}` }
            });

            bootstrap.Modal.getInstance(document.getElementById('toggleActiveModal')).hide();

            if (response.ok) {
                toggleActiveTargetId = null;
                loadUsers();
            } else {
                const result = await response.json();
                alert(result.message || 'Failed to update user status');
            }
        } catch (err) {
            alert('Something went wrong');
        }
    }
</script>
@model HealthcareCRM.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — HealthcareCRM</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #0a0a0a;
            color: #ffffff;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: absolute;
            width: 700px;
            height: 700px;
            background: radial-gradient(circle, rgba(0,255,136,0.07) 0%, transparent 70%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
        }

        .back-link {
            position: absolute;
            top: 2rem;
            left: 2rem;
            color: #555;
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.2s;
            z-index: 2;
        }

        .back-link:hover { color: #00ff88; }

        .auth-card {
            width: 100%;
            max-width: 420px;
            background: #111;
            border: 1px solid #222;
            border-radius: 16px;
            padding: 2.75rem;
            position: relative;
            z-index: 1;
            box-shadow: 0 20px 60px -20px rgba(0,0,0,0.6);
        }

        .auth-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            font-size: 1.3rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 0.5rem;
        }

        .auth-logo span { color: #00ff88; }

        .auth-logo svg {
            width: 20px;
            height: 20px;
            filter: drop-shadow(0 0 4px rgba(0,255,136,0.6));
        }

        .auth-subtitle {
            text-align: center;
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 2.2rem;
        }

        #error-alert {
            background: #2a1212;
            border: 1px solid #4a1f1f;
            color: #ff8f8f;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            font-size: 0.85rem;
            margin-bottom: 1.25rem;
        }

        .form-group { margin-bottom: 1.25rem; }

        .form-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: #aaa;
            margin-bottom: 0.5rem;
        }

        .form-control {
            width: 100%;
            background: #0a0a0a;
            border: 1px solid #262626;
            color: #fff;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            font-size: 0.95rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-control::placeholder { color: #444; }

        .form-control:focus {
            outline: none;
            border-color: #00ff88;
            box-shadow: 0 0 0 3px rgba(0,255,136,0.12);
        }

        .field-error {
            color: #ff8f8f;
            font-size: 0.8rem;
            margin-top: 0.35rem;
            display: block;
        }

        .btn-submit {
            width: 100%;
            background: #00ff88;
            color: #0a0a0a;
            border: none;
            padding: 0.85rem;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 800;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.15s;
            margin-top: 0.25rem;
            margin-bottom: 1.5rem;
        }

        .btn-submit:hover { opacity: 0.9; transform: translateY(-1px); }
        .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

        .auth-footer {
            text-align: center;
            font-size: 0.9rem;
            color: #666;
        }

        .auth-footer a {
            color: #00ff88;
            text-decoration: none;
            font-weight: 600;
        }

        .auth-footer a:hover { text-decoration: underline; }

        .d-none { display: none; }
    </style>
</head>
<body>

<a class="back-link" asp-action="Index" asp-controller="Home">← Back to home</a>

<div class="auth-card">
    <div class="auth-logo">
        <svg viewBox="0 0 48 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,12 L10,12 L14,3 L18,21 L22,12 L26,12 L30,18 L34,6 L38,12 L48,12"
                  fill="none" stroke="#00ff88" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Healthcare<span>CRM</span>
    </div>
    <p class="auth-subtitle">Sign in to your account</p>

    <div id="error-alert" class="d-none"></div>

    <form id="login-form">
        <div class="form-group">
            <label class="form-label">Email</label>
            <input asp-for="Email" type="email" id="email" class="form-control" placeholder="Enter your email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="form-group">
            <label class="form-label">Password</label>
            <input asp-for="Password" type="password" id="password" class="form-control" placeholder="Enter your password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <button type="submit" id="login-btn" class="btn-submit">Login</button>
        <div class="auth-footer">
            Don't have an account? <a asp-action="Register" asp-controller="Account">Register</a>
        </div>
    </form>
</div>

<script>
    document.getElementById('login-form').addEventListener('submit', async function (e) {
        e.preventDefault();

        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;
        const loginBtn = document.getElementById('login-btn');
        const errorAlert = document.getElementById('error-alert');

                loginBtn.disabled = true;
                loginBtn.textContent = 'Logging in...';

        try {

            const response = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });

            const data = await response.json();

            if (response.ok) {
                // Store JWT in localStorage
                localStorage.setItem('jwt', data.token);
                window.location.href = '/Home/Index';
            } else {
                loginBtn.disabled = false;
                loginBtn.textContent = 'Login';
                errorAlert.classList.remove('d-none');
                errorAlert.textContent = data.message || 'Invalid email or password';

            }
        } catch (err) {
            loginBtn.disabled = false;
            loginBtn.textContent = 'Login';
            errorAlert.classList.remove('d-none');
            errorAlert.textContent = 'Something went wrong. Please try again.';

        }
    });
</script>

</body>
</html>

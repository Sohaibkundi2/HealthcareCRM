@model HealthcareCRM.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register — HealthcareCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="auth-body">

<a class="back-link" asp-action="Index" asp-controller="Home">← Back to home</a>

<div class="auth-card">
    <div class="auth-logo">
        <svg viewBox="0 0 48 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,12 L10,12 L14,3 L18,21 L22,12 L26,12 L30,18 L34,6 L38,12 L48,12"
                  fill="none" stroke="#00ff88" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Healthcare<span>CRM</span>
    </div>
    <p class="auth-subtitle">Create your account</p>

    <div id="error-alert" class="d-none"></div>

    <form id="register-form">
        <div class="form-group">
            <label class="form-label">Full Name</label>
            <input asp-for="FullName" id="FullName" class="form-control" placeholder="Enter your full name" />
            <span asp-validation-for="FullName" class="field-error"></span>
        </div>
        <div class="form-group">
            <label class="form-label">Email</label>
            <input asp-for="Email" type="email" id="Email" class="form-control" placeholder="Enter your email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="form-group">
            <label class="form-label">Password</label>
            <input asp-for="Password" type="password" id="Password" class="form-control" placeholder="Enter your password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="form-group">
            <label class="form-label">Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" id="ConfirmPassword" class="form-control" placeholder="Confirm your password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <div class="form-group">
            <label class="form-label">Role</label>
            <select id="Role" class="form-control" style="background:#0a0a0a; color:white; border:1px solid #262626;">
                <option value="Staff">Staff</option>
                <option value="Admin">Admin</option>
            </select>
        </div>

        <button type="submit" id="register-btn" class="btn-submit">Register</button>
        <div class="auth-footer">
            Already have an account? <a asp-action="Login" asp-controller="Account">Login</a>
        </div>
    </form>
</div>

<script>
    document.getElementById('register-form').addEventListener('submit', async function (e) {
        e.preventDefault();

        const fullName = document.getElementById('FullName').value;
        const email = document.getElementById('Email').value;
        const password = document.getElementById('Password').value;
        const confirmPassword = document.getElementById('ConfirmPassword').value;
        const role = document.getElementById('Role').value ;
        const errorAlert = document.getElementById('error-alert');
        const registerBtn = document.getElementById('register-btn');

        // Frontend validation
        if (!fullName) {
            errorAlert.classList.remove('d-none');
            errorAlert.textContent = 'Full name is required';
            return;
        }
        if (!email) {
            errorAlert.classList.remove('d-none');
            errorAlert.textContent = 'Email is required';
            return;
        }
        if (!password || password.length < 6) {
            errorAlert.classList.remove('d-none');
            errorAlert.textContent = 'Password must be at least 6 characters';
            return;
        }
        if (password !== confirmPassword) {
            errorAlert.classList.remove('d-none');
            errorAlert.textContent = 'Passwords do not match';
            return;
        }

        errorAlert.classList.add('d-none');
        registerBtn.disabled = true;
        registerBtn.textContent = 'Creating account...';

        try {
            const response = await fetch('/api/auth/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ fullName, email, password, confirmPassword, role })
            });

            const data = await response.json();

            if (response.ok) {
                localStorage.setItem('jwt', data.token);
                window.location.replace('/Home/Index');
            } else {
                registerBtn.disabled = false;
                registerBtn.textContent = 'Register';
                errorAlert.classList.remove('d-none');
                errorAlert.textContent = data.message || 'Registration failed';
            }
        } catch (err) {
            registerBtn.disabled = false;
            registerBtn.textContent = 'Register';
            errorAlert.classList.remove('d-none');
            errorAlert.textContent = 'Something went wrong. Please try again.';
        }
    });
</script>

</body>
</html>

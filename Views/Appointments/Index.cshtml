@{
    ViewData["Title"] = "Appointments";
}

<style>
    body { background: #0a0a0a !important; color: white; }

    .page-title { font-size: 1.8rem; font-weight: 900; letter-spacing: -1px; }

    .btn-book {
        background: #00ff88;
        color: #0a0a0a;
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        transition: opacity 0.2s;
        display: inline-block;
    }

    .btn-book:hover { opacity: 0.85; color: #0a0a0a; }

    .filter-bar { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }

    .filter-btn {
        background: transparent;
        border: 1px solid #222;
        color: #666;
        padding: 0.4rem 1.1rem;
        border-radius: 100px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .filter-btn:hover { border-color: #444; color: #aaa; }
    .filter-btn.active { background: #00ff88; border-color: #00ff88; color: #0a0a0a; }
    .filter-btn.pending.active { background: #ffc107; border-color: #ffc107; color: #0a0a0a; }
    .filter-btn.confirmed.active { background: #00ff88; border-color: #00ff88; color: #0a0a0a; }
    .filter-btn.cancelled.active { background: #ff4444; border-color: #ff4444; color: white; }

    .dark-card {
        background: #111;
        border: 1px solid #1a1a1a;
        border-radius: 12px;
        overflow: hidden;
    }

    .dark-table { color: white; width: 100%; border-collapse: collapse; }

    .dark-table thead th {
        background: #0d0d0d;
        color: #555;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #1a1a1a;
    }

    .dark-table tbody td {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #111;
        font-size: 0.9rem;
        vertical-align: middle;
    }

    .dark-table tbody tr:hover { background: #151515; }

    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .status-pending { background: #1f1a0d; color: #ffc107; border: 1px solid #3d3010; }
    .status-confirmed { background: #0d1f15; color: #00ff88; border: 1px solid #1a3d26; }
    .status-cancelled { background: #1f0d0d; color: #ff4444; border: 1px solid #3d1a1a; }

    .btn-action {
        background: #1a1a1a;
        color: #aaa;
        border: 1px solid #222;
        padding: 0.3rem 0.8rem;
        border-radius: 6px;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
        margin-right: 0.3rem;
    }

    .btn-action.update:hover { border-color: #00ff88; color: #00ff88; }
    .btn-action.cancel:hover { border-color: #ff4444; color: #ff4444; }

    .empty-state { text-align: center; padding: 4rem; color: #333; }

    .modal-content {
        background: #111 !important;
        border: 1px solid #222 !important;
        color: white !important;
    }

    .modal-header { border-bottom: 1px solid #1a1a1a !important; }
    .modal-footer { border-top: 1px solid #1a1a1a !important; }
    .btn-close { filter: invert(1); }

    .dark-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #888;
        margin-bottom: 0.4rem;
        display: block;
    }

    .dark-select {
        background: #0a0a0a !important;
        border: 1px solid #262626 !important;
        color: white !important;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        width: 100%;
        font-size: 0.9rem;
    }

    .dark-select:focus {
        outline: none;
        border-color: #00ff88 !important;
        box-shadow: 0 0 0 3px rgba(0,255,136,0.1) !important;
    }

    .dark-select option { background: #111; }

    .btn-save {
        background: #00ff88;
        color: #0a0a0a;
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .btn-save:hover { opacity: 0.85; }

    .btn-cancel-modal {
        background: transparent;
        color: #555;
        border: 1px solid #222;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-cancel-modal:hover { border-color: #555; color: #aaa; }

    .btn-cancel-confirm {
        background: #ff4444;
        color: white;
        border: none;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .btn-cancel-confirm:hover { opacity: 0.85; }

    .spinner-border { color: #00ff88 !important; }
</style>

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title mb-0">Appointments</h2>
        <a href="/Appointments/Book" class="btn-book">+ Book Appointment</a>
    </div>

    <!-- Filter -->
    <div class="filter-bar">
        <button class="filter-btn active" onclick="filterByStatus(this, '')">All</button>
        <button class="filter-btn pending" onclick="filterByStatus(this, 'Pending')">Pending</button>
        <button class="filter-btn confirmed" onclick="filterByStatus(this, 'Confirmed')">Confirmed</button>
        <button class="filter-btn cancelled" onclick="filterByStatus(this, 'Cancelled')">Cancelled</button>
    </div>

    <!-- Loading -->
    <div id="loading" class="text-center py-5">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2" style="color:#555;">Loading appointments...</p>
    </div>

    <!-- Table -->
    <div class="dark-card d-none" id="appointments-card">
        <table class="dark-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Date & Time</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="appointments-table"></tbody>
        </table>
        <div id="empty-state" class="empty-state d-none">No appointments found.</div>
    </div>
</div>

<!-- Update Status Modal -->
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Update Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="status-appointment-id" />
                <label class="dark-label">Select Status</label>
                <select id="status-select" class="dark-select">
                    <option value="Pending">Pending</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel-modal" data-bs-dismiss="modal">Cancel</button>
                <button class="btn-save" onclick="confirmStatusUpdate()">Update</button>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Confirm Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Cancel Appointment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="color:#aaa;">
                Are you sure you want to cancel this appointment? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button class="btn-cancel-modal" data-bs-dismiss="modal">No, Keep It</button>
                <button class="btn-cancel-confirm" onclick="confirmCancel()">Yes, Cancel</button>
            </div>
        </div>
    </div>
</div>

<script>
    if (!token) window.location.href = '/Account/Login';

    let currentStatus = '';
    let cancelTargetId = null;

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(text || ''));
        return div.innerHTML;
    }

    function getStatusBadge(status) {
        const map = {
            'Pending': 'status-pending',
            'Confirmed': 'status-confirmed',
            'Cancelled': 'status-cancelled'
        };
        return `<span class="status-badge ${map[status] || ''}">${status}</span>`;
    }

    async function loadAppointments() {
        try {
            const url = currentStatus
                ? `/api/appointments?status=${currentStatus}`
                : '/api/appointments';

            const response = await fetch(url, {
                headers: { 'Authorization': `Bearer ${token}` }
            });

            if (!response.ok) throw new Error('Failed to load');

            const result = await response.json();

            document.getElementById('loading').classList.add('d-none');
            document.getElementById('appointments-card').classList.remove('d-none');

            if (!result.data || result.data.length === 0) {
                document.getElementById('empty-state').classList.remove('d-none');
                document.getElementById('appointments-table').innerHTML = '';
                return;
            }

            document.getElementById('empty-state').classList.add('d-none');
            document.getElementById('appointments-table').innerHTML = result.data.map((a, i) => `
                <tr>
                    <td style="color:#555;">${i + 1}</td>
                    <td style="font-weight:600;">${escapeHtml(a.patient?.fullName || '—')}</td>
                    <td style="color:#888;">${escapeHtml(a.doctor?.name || '—')}</td>
                    <td style="color:#888;">${new Date(a.appointmentDate).toLocaleString()}</td>
                    <td>${getStatusBadge(a.status)}</td>
                    <td>
                        <button class="btn-action update" onclick="showStatusModal(${a.id}, '${a.status}')">Update</button>
                        ${a.status !== 'Cancelled' ? `<button class="btn-action cancel" onclick="showCancelConfirm(${a.id})">Cancel</button>` : ''}
                    </td>
                </tr>
            `).join('');

        } catch (err) {
            document.getElementById('loading').innerHTML =
                '<p style="color:#ff6b6b; text-align:center;">Failed to load appointments. Please try again.</p>';
        }
    }

    function filterByStatus(btn, status) {
        currentStatus = status;
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('loading').classList.remove('d-none');
        document.getElementById('appointments-card').classList.add('d-none');
        loadAppointments();
    }

    function showStatusModal(id, status) {
        document.getElementById('status-appointment-id').value = id;
        document.getElementById('status-select').value = status;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('statusModal')).show();
    }

    async function confirmStatusUpdate() {
        const id = document.getElementById('status-appointment-id').value;
        const status = document.getElementById('status-select').value;

        try {
            const response = await fetch(`/api/appointments/${id}/status`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({ status })
            });

            bootstrap.Modal.getInstance(document.getElementById('statusModal')).hide();
            if (response.ok) loadAppointments();
            else alert('Failed to update status');
        } catch (err) {
            alert('Something went wrong. Please try again.');
        }
    }

    function showCancelConfirm(id) {
        cancelTargetId = id;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('cancelModal')).show();
    }

    async function confirmCancel() {
        if (!cancelTargetId) return;

        try {
            const response = await fetch(`/api/appointments/${cancelTargetId}/cancel`, {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${token}` }
            });

            bootstrap.Modal.getInstance(document.getElementById('cancelModal')).hide();
            if (response.ok) { cancelTargetId = null; loadAppointments(); }
            else alert('Failed to cancel appointment');
        } catch (err) {
            alert('Something went wrong. Please try again.');
        }
    }

    loadAppointments();
</script>